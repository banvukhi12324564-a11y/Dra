local function SendMessage(player, text, color, time, lock)

	CodeMessageEvent:FireClient(

		player,

		text,

		color,

		time,

		lock

	)

end

--========================================================

-- FIND TOOL

--========================================================

local function FindTool(toolName)

	if not toolName or toolName == "" then

		return nil

	end

	for _, item in ipairs(

		ServerStorage:GetDescendants()

		) do

		if item:IsA("Tool")

			and item.Name:lower()

			== tostring(toolName):lower() then

			return item

		end

	end

	return nil

end

--========================================================

-- CHECK ADMIN

--========================================================

local function IsAdmin(player)

	local playerName =

		player.Name:lower()

	for adminName in pairs(Admins) do

		if adminName ~= ""

			and adminName:lower()

			== playerName then

			return true

		end

	end

	-- AdminList dùng chung

	local adminList =

		ReplicatedStorage:GetAttribute("AdminList")

	if adminList then

		for name in string.gmatch(

			adminList,

			"([^,]+)"

			) do

			name =

				name:lower()

				:gsub("%s+", "")

			if name == playerName then

				return true

			end

		end

	end

	return false

end

