Players.PlayerAdded:Connect(function(player)

	player.Chatted:Connect(function(message)

		if not IsAdmin(player) then

			return

		end

		--==================================================

		-- /taocode "CODE" "TOOL" "LƯỢT"

		--==================================================

		local code, tool, limit =

			message:match(

				'^/taocode%s+"([^"]+)"%s+"([^"]+)"%s+"([^"]+)"$'

			)

		if code and tool and tonumber(limit) then

			-- Code trùng

			if Codes[code] then

				SendMessage(

					player,

					"[❌] Code đã tồn tại!",

					Color3.fromRGB(255, 100, 100),

					2

				)

				return

			end

			-- Kiểm tra Tool

			if not FindTool(tool) then

				SendMessage(

					player,

					"[❌] Không tìm thấy Tool: "

						.. tool,

					Color3.fromRGB(255, 100, 100),

					2

				)

				return

			end

			Codes[code] = {

				Type = "Tool",

				Tool = tool,

				MaxUses = tonumber(limit),

				Uses = 0

			}

			SendMessage(

				player,

				"[✅] Đã tạo code: "

					.. code

					.. ",

				Color3.fromRGB(80, 255, 80),

				2

			)

			return

		end

		--==================================================

		-- SAI CÚ PHÁP

		--==================================================

		if message:lower():sub(1, 8)

			== "/taocode" then

			SendMessage(

				player,

				'[❌] Cú pháp: /taocode "CODE" "TOOL" "LƯỢT"',

				Color3.fromRGB(255, 100, 100),

				3

			)

		end

	end)

end)

