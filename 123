local function GetRemote(name)

	local remote =
		ReplicatedStorage:FindFirstChild(name)

	if not remote then

		remote = Instance.new("RemoteEvent")

		remote.Name = name

		remote.Parent = ReplicatedStorage

	end

	return remote
end

