RedeemCodeEvent.OnServerEvent:Connect(
	function(player, code)

		if not code then
			return
		end

		code = tostring(code)

		if code == "" then
			return
		end

		local codeData =
			Codes[code]

		--================================================
		-- CODE KHÔNG TỒN TẠI
		--================================================

		if not codeData then

			SendMessage(
				player,
				"[❌] Code không tồn tại!",
				Color3.fromRGB(
					255,
					80,
					80
				),
				1
			)

			return

		end

		--================================================
		-- HẾT HẠN
		--================================================

		if codeData.ExpireAt
			and os.time()
			> codeData.ExpireAt
		then

			SendMessage(
				player,
				"[❌] Code này đã hết hạn!",
				Color3.fromRGB(
					255,
					100,
					100
				),
				1
			)

			return

		end

		--================================================
		-- HẾT LƯỢT
		--================================================

		if codeData.MaxUses ~= -1
			and (codeData.Uses or 0)
			>= codeData.MaxUses
		then

			SendMessage(
				player,
				"[❌] Code đã hết lượt sử dụng!",
				Color3.fromRGB(
					255,
					100,
					100
				),
				1
			)

			return

		end

		--================================================
		-- LOAD CODE ĐÃ NHẬP
		--================================================

		local success, redeemedList =
			pcall(function()

				return CodeStore:GetAsync(
					"User_" ..
						player.UserId
				)

			end)

		if not success
			or type(redeemedList) ~= "table"
		then

			redeemedList = {}

		end

		--================================================
		-- ĐÃ NHẬP
		--================================================

		if redeemedList[code] then

			SendMessage(
				player,
				"[💎] Bạn đã nhập code này rồi!",
				Color3.fromRGB(
					255,
					255,
					100
				),
				1
			)

			return

		end

		--================================================
		-- MONEY
		--================================================

		if codeData.Type == "Money" then

			local leaderstats =
				player:FindFirstChild(
					"leaderstats"
				)

			local money =
				leaderstats
				and (
					leaderstats:FindFirstChild(
						"Money"
					)

					or leaderstats:FindFirstChild(
						"Tiền"
					)

					or leaderstats:FindFirstChild(
						"Cash"
					)
				)

			if not money then

				SendMessage(
					player,
					"[❌] Không tìm thấy Money!",
					Color3.fromRGB(
						255,
						60,
						60
					),
					1.5
				)

				return

			end

			local amount =
				tonumber(
					codeData.Amount
				) or 0

			money.Value += amount

			SendMessage(
				player,
				"[✅] Nhận +" ..
					tostring(amount) ..
					"$",
				Color3.fromRGB(
					80,
					255,
					80
				),
				3,
				true
			)

		--================================================
		-- TOOL
		--================================================

		else

			local tool =
				FindTool(
					codeData.Tool
				)

			if not tool then

				SendMessage(
					player,
					"[❌] Không tìm thấy Tool: "
						.. tostring(
							codeData.Tool
						),
					Color3.fromRGB(
						255,
						60,
						60
					),
					1.5
				)

				return

			end

			--================================================
			-- KIỂM TRA ĐÃ CÓ TOOL
			--================================================

			if player.Backpack:FindFirstChild(
				tool.Name
			)
				or player.StarterGear:FindFirstChild(
					tool.Name
				)
				or (
					player.Character
					and player.Character:FindFirstChild(
						tool.Name
					)
				)
			then

				SendMessage(
					player,
					"[⚠️] Bạn đã sở hữu vũ khí này!",
					Color3.fromRGB(
						255,
						220,
						100
					),
					1
				)

				return

			end

			--================================================
			-- TRAO TOOL
			--================================================

			local backpackTool =
				tool:Clone()

			backpackTool.Parent =
				player.Backpack

			local starterTool =
				tool:Clone()

			starterTool.Parent =
				player.StarterGear

			SendMessage(
				player,
				"[✅] Nhận vũ khí: "
					.. tool.Name,
				Color3.fromRGB(
					80,
					255,
					80
				),
				3,
				true
			)

		end

		--================================================
		-- ĐÁNH DẤU ĐÃ NHẬP
		--================================================

		codeData.Uses =
			(codeData.Uses or 0) + 1

		redeemedList[code] = true

		pcall(function()

			CodeStore:SetAsync(
				"User_" ..
					player.UserId,
				redeemedList
			)

		end)

	end
)

--========================================================
-- ADMIN CODE EVENT
--========================================================

AdminCodeEvent.OnServerEvent:Connect(
	function(
		player,
		action,
		data
	)

		--================================================
		-- CHECK ADMIN
		--================================================

		if not IsAdmin(player) then

			AdminCodeEvent:FireClient(
				player,
				"NotAdmin"
			)

			return

		end

		--================================================
		-- CHECK ADMIN
		--================================================

		if action == "CheckAdmin" then

			AdminCodeEvent:FireClient(
				player,
				"AdminOK"
			)

			return

		end

		--================================================
		-- GET CODES
		--================================================

		if action == "GetCodes" then

			local list = {}

			for codeName, info
				in pairs(Codes)
			do

				table.insert(
					list,
					{
						CodeName = codeName,

						Type =
							info.Type
							or "Tool",

						Amount =
							info.Amount
							or tonumber(
								info.Reward
							)
							or 0,

						Tool =
							info.Tool
							or info.Reward
							or "Unknown",

						MaxUses =
							info.MaxUses
							or -1,

						Uses =
							info.Uses
							or 0,

						ExpireAt =
							info.ExpireAt
					}
				)

			end

			AdminCodeEvent:FireClient(
				player,
				"CodeList",
				list
			)

			return

		end

		--================================================
		-- CREATE CODE
		--================================================

		if action == "CreateCode" then

			if type(data) ~= "table"
				or not data.CodeName
			then

				return

			end

			local codeName =
				tostring(
					data.CodeName
				):match(
					"^%s*(.-)%s*$"
				)

			if codeName == "" then
				return
			end

			--================================================
			-- CODE TRÙNG
			--================================================

			if Codes[codeName] then

				AdminCodeEvent:FireClient(
					player,
					"CreateResult",
					false,
					"❌ Code này đã tồn tại!"
				)

				return

			end

			--================================================
			-- TYPE
			--================================================

			local codeType =
				data.Type == "Money"
				and "Money"
				or "Tool"

			--================================================
			-- MAX USES
			--================================================

			local maxUses =
				tonumber(
					data.MaxUses
				)

			if not maxUses
				or maxUses < 1
			then

				AdminCodeEvent:FireClient(
					player,
					"CreateResult",
					false,
					"❌ Số lượt sử dụng không hợp lệ!"
				)

				return

			end

			local newCode = {

				Type = codeType,

				MaxUses = maxUses,

				Uses = 0

			}

			--================================================
			-- MONEY
			--================================================

			if codeType == "Money" then

				local amount =
					tonumber(
						data.Reward
					)

				if not amount
					or amount <= 0
				then

					AdminCodeEvent:FireClient(
						player,
						"CreateResult",
						false,
						"❌ Số tiền không hợp lệ!"
					)

					return

				end

				newCode.Amount =
					amount

			--================================================
			-- TOOL
			--================================================

			else

				local toolName =
					tostring(
						data.Reward
						or ""
					):match(
						"^%s*(.-)%s*$"
					)

				if toolName == "" then

					AdminCodeEvent:FireClient(
						player,
						"CreateResult",
						false,
						"❌ Chưa nhập tên Tool!"
					)

					return

				end

				if not FindTool(
					toolName
				) then

					AdminCodeEvent:FireClient(
						player,
						"CreateResult",
						false,
						"❌ Không tìm thấy Tool: "
							.. toolName
					)

					return

				end

				newCode.Tool =
					toolName

			end

			--================================================
			-- EXPIRE
			--================================================

			local timeMinutes =
				tonumber(
					data.TimeMinutes
				)

			if timeMinutes
				and timeMinutes > 0
			then

				newCode.ExpireAt =
					os.time()
					+ timeMinutes * 60

			end

			Codes[codeName] =
				newCode

			AdminCodeEvent:FireClient(
				player,
				"CreateResult",
				true,
				"✅ Tạo thành công!"
			)

			return

		end

		--================================================
		-- DELETE CODE
		--================================================

		if action == "DeleteCode" then

			local codeName =
				tostring(
					data or ""
				)

			if Codes[codeName] then

				Codes[codeName] = nil

				AdminCodeEvent:FireClient(
					player,
					"DeleteResult",
					true,
					"✅ Đã xóa code!"
				)

			else

				AdminCodeEvent:FireClient(
					player,
					"DeleteResult",
					false,
					"❌ Code không tồn tại!"
				)

			end

			return

		end

	end
)

