--========================================================
-- IMPORT CODE TỪ DISCORD BOT / API
--========================================================

local function ImportDiscordCodes()

	if DiscordCodeAPI == ""
		or DiscordCodeAPI:find(
			"YOUR%-API%-DOMAIN"
		)
	then

		return

	end

	local ok, result =
		pcall(
			function()

				return HttpService:GetAsync(
					DiscordCodeAPI
						.. "?key="
						.. HttpService:UrlEncode(
							DiscordAPIKey
						),
					false
				)

			end
		)

	if not ok then

		warn(
			"[DiscordCode] Không lấy được code từ API: "
				.. tostring(result)
		)

		return

	end

	local decodeOk, data =
		pcall(
			function()

				return HttpService:JSONDecode(
					result
				)

			end
		)

	if not decodeOk
		or type(data) ~= "table"
		or type(data.codes) ~= "table"
	then

		warn(
			"[DiscordCode] API trả dữ liệu không hợp lệ"
		)

		return

	end

	--================================================
	-- IMPORT CODES
	--================================================

	for _, item in ipairs(
		data.codes
	) do

		local codeName =
			tostring(
				item.code or ""
			)

		if codeName ~= ""
			and not Codes[codeName]
		then

			local codeType =
				item.type == "Money"
				and "Money"
				or "Tool"

			local maxUses =
				tonumber(
					item.maxUses
				)

			if maxUses
				and maxUses >= 1
			then

				local newCode = {

					Type = codeType,

					MaxUses = maxUses,

					Uses =
						tonumber(
							item.uses
						) or 0,

				}

				--================================================
				-- MONEY
				--================================================

				if codeType == "Money" then

					newCode.Amount =
						tonumber(
							item.amount
						) or 0

				--================================================
				-- TOOL
				--================================================

				else

					newCode.Tool =
						tostring(
							item.tool or ""
						)

				end

				--================================================
				-- EXPIRE
				--================================================

				if tonumber(
					item.expireAt
				)
					and tonumber(
						item.expireAt
					) > 0
				then

					newCode.ExpireAt =
						tonumber(
							item.expireAt
						)

				end

				--================================================
				-- ADD CODE
				--================================================

				if (
					codeType == "Money"
					and newCode.Amount > 0
				)
					or (
						codeType == "Tool"
						and newCode.Tool ~= ""
					)
				then

					Codes[codeName] =
						newCode

					print(
						"[DiscordCode] Đã nhập code: "
							.. codeName
					)

				end

			end

		end

	end

end

